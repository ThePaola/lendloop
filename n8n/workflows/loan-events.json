{"updatedAt":"2026-11-06T00:56:33.063Z","createdAt":"2026-11-05T22:23:04.404Z","id":"J8qGjMK0GWxay3Wq","name":"LendLoop: Loan events","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"httpMethod":"POST","path":"lendloop-loan-events","responseMode":"responseNode","options":{"rawBody":true}},"type":"n8n-nodes-base.webhook","typeVersion":2.2,"position":[0,0],"id":"b08cdebf-69b8-4318-99a4-c5f805a88608","name":"Webhook","webhookId":"946ee4e5-4593-4833-89b9-0a26c5ed78ad"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":4},"conditions":[{"id":"a80961f7-d276-4cd3-9b21-9af6f05608f5","leftValue":"={{ $json.valid }}","rightValue":"","operator":{"type":"boolean","operation":"false","singleValue":true}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.4,"position":[352,0],"id":"d7810a38-2484-43a4-bcdb-22a551c861f9","name":"If"},{"parameters":{"respondWith":"noData","options":{"responseCode":401}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[736,-16],"id":"90525540-a37a-45a2-a8cc-1d740398bc96","name":"Respond 401"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":4},"conditions":[{"id":"4413a079-4d31-4e61-8c76-d83f16b1ff08","leftValue":"={{ $json.duplicate }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.4,"position":[512,112],"id":"4358e53c-b7cf-465b-bf19-0e757d331a25","name":"If1"},{"parameters":{"respondWith":"json","responseBody":"{ \"duplicate\": true }","options":{"responseCode":200}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[736,96],"id":"14064340-fab3-4a61-b10e-823ca070150b","name":"Respond duplicate"},{"parameters":{"jsCode":"const { event } = $('Verify signature').first().json;\nconst name = event.recipient.firstName;\nconst tool = event.tool.name;\nconst who = event.counterpartFirstName;\nconst dates = `${event.loan.startDate} to ${event.loan.endDate}`;\n\nlet subject;\nlet text;\nif (event.type === 'request_created') {\n  subject = `${who} wants to borrow your ${tool}`;\n  text = `Hi ${name},\\n\\n${who} asked to borrow your ${tool} (${dates}).\\nOpen LendLoop to approve or decline.`;\n} else {\n  const status = event.loan.status;\n  const verb = { approved: 'approved', declined: 'declined', returned: 'marked as returned', cancelled: 'cancelled' }[status] ?? status;\n  subject = `Your request for the ${tool} was ${verb}`;\n  text = `Hi ${name},\\n\\nThe loan of the ${tool} (${dates}) was ${verb}.`;\n}\n\nreturn [{ json: { to: event.recipient.email, subject, text } }];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[736,208],"id":"fc2c1c38-64bf-4638-a513-3e04ff193d2e","name":"Compose message"},{"parameters":{"respondWith":"json","responseBody":"{\n  \"ok\": true\n}","options":{"responseCode":200}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[1488,192],"id":"ade059f1-e386-4c7c-93c1-9a8edfd37d6e","name":"Respond to Webhook 200"},{"parameters":{"respondWith":"noData","options":{"responseCode":500}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[1248,336],"id":"7df75652-9495-4c56-83ba-1c18591cb5d8","name":"Respond to Webhook 500"},{"parameters":{"errorMessage":"=Send Email failed: {{ $json.error?.message ?? 'unknown error' }}"},"type":"n8n-nodes-base.stopAndError","typeVersion":1,"position":[1488,336],"id":"52244d2d-1148-42b6-8b3e-a325af60ba61","name":"Stop and Error"},{"parameters":{"jsCode":"const crypto = require('crypto');\nconst headers = $input.first().json.headers;\nconst ts = headers['x-lendloop-timestamp'] || '';\nconst sig = (headers['x-lendloop-signature'] || '').replace(/^sha256=/, '');\nconst raw = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\n\nconst fresh = /^\\d+$/.test(ts) && Math.abs(Date.now() / 1000 - Number(ts)) <= 300;\nconst expected = crypto\n  .createHmac('sha256', $env.LENDLOOP_CONVEX_TO_N8N_SECRET)\n  .update(`${ts}.${raw}`, 'utf8')\n  .digest('hex');\nconst valid = fresh && /^[0-9a-f]{64}$/i.test(sig) &&\n  crypto.timingSafeEqual(Buffer.from(sig, 'hex'), Buffer.from(expected, 'hex'));\n\nif (!valid) return [{ json: { valid: false } }];\n\nconst event = JSON.parse(raw);\nconst seen = $getWorkflowStaticData('global');\nconst duplicate = Boolean(seen.events?.[event.eventId]);\nreturn [{ json: { valid: true, duplicate, event } }];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[176,0],"id":"652b9d01-8b7a-4597-a16a-c0dd3e856642","name":"Verify signature"},{"parameters":{"jsCode":"const seen = $getWorkflowStaticData('global');\nseen.events ??= {};\nconst weekAgo = Date.now() - 7 * 24 * 3600 * 1000;\nfor (const [id, at] of Object.entries(seen.events)) if (at < weekAgo) delete seen.events[id];\nseen.events[$('Verify signature').first().json.event.eventId] = Date.now();\nreturn $input.all();"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1248,192],"id":"bf6c50dd-519a-4e8e-9b79-e402c8948c62","name":"Mark proceed"},{"parameters":{"fromEmail":"no-reply@lendloop.local","toEmail":"={{ $json.to }}","subject":"={{ $json.subject }}","emailFormat":"text","text":"={{ $json.text }}","options":{}},"type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[960,208],"id":"9c0912e1-0e5a-4117-9bf2-361634805ff2","name":"Send an email","webhookId":"f891c89d-f752-477a-9cf1-64c88302dd88","retryOnFail":true,"waitBetweenTries":5000,"credentials":{"smtp":{"id":"L0BzhZwOdF8cuATs","name":"Mailpit SMTP"}},"onError":"continueErrorOutput"}],"connections":{"Webhook":{"main":[[{"node":"Verify signature","type":"main","index":0}]]},"If":{"main":[[{"node":"Respond 401","type":"main","index":0}],[{"node":"If1","type":"main","index":0}]]},"If1":{"main":[[{"node":"Respond duplicate","type":"main","index":0}],[{"node":"Compose message","type":"main",