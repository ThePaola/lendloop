# Docker Compose (n8n). Copy to .env and fill in.
# Use the SAME two HMAC secrets you set in Convex with `npx convex env set`.
CONVEX_TO_N8N_SECRET=
N8N_TO_CONVEX_SECRET=
# Encrypts credentials stored by n8n. Generate a third random value.
N8N_ENCRYPTION_KEY=
# How the n8n container reaches Convex HTTP actions on your machine.
CONVEX_SITE_URL_FOR_N8N=http://host.docker.internal:3211